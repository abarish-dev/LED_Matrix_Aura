{
  "expo": {
    "name": "Aura 2",
    "slug": "aura-matrix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "auratwo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abarish.auratwo",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Connect to your LED matrix to sync settings",
        "NSBluetoothPeripheralUsageDescription": "Connect to your LED matrix to sync settings",
        "NSLocationWhenInUseUsageDescription": "Auto-fill your local flights & weather"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#14171d"
      },
      "package": "com.abarish.auratwo",
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#14171d",
          "dark": {
            "image": "./assets/images/splash-image.png",
            "imageWidth": 220,
            "resizeMode": "contain",
            "backgroundColor": "#14171d"
          }
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": false,
          "bluetoothAlwaysPermission": "Connect to your LED matrix to sync settings"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Auto-fill your local flights & weather"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7adafa96-660d-47a9-a874-dc5ab4168cf9"
      }
    },
    "owner": "abarish"
  }
}
