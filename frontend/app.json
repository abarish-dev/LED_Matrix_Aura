{
  "expo": {
    "name": "Aura 2",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "auratwo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.auratwo.hltjsu",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Connect to your LED matrix to sync settings",
        "NSBluetoothPeripheralUsageDescription": "Connect to your LED matrix to sync settings",
        "NSLocationWhenInUseUsageDescription": "Auto-fill your local flights & weather"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#14171d"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.auratwo.hltjsu",
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#14171d",
          "dark": {
            "image": "./assets/images/splash-image.png",
            "imageWidth": 220,
            "resizeMode": "contain",
            "backgroundColor": "#14171d"
          }
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": false,
          "bluetoothAlwaysPermission": "Connect to your LED matrix to sync settings"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Auto-fill your local flights & weather"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
